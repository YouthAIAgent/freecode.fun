#!/usr/bin/env sh
set -e
GRADLE_VERSION="8.5"
GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"
DIST_DIR="${GRADLE_USER_HOME}/wrapper/dists/gradle-${GRADLE_VERSION}-bin"
ZIP_FILE="/tmp/gradle-${GRADLE_VERSION}-bin.zip"
if [ ! -f "${DIST_DIR}/gradle-${GRADLE_VERSION}/bin/gradle" ]; then
    echo "Downloading Gradle ${GRADLE_VERSION}..."
    mkdir -p "${GRADLE_USER_HOME}/wrapper/dists"
    curl -sL "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -o "${ZIP_FILE}"
    unzip -q "${ZIP_FILE}" -d "${GRADLE_USER_HOME}/wrapper/dists/"
    mv "${GRADLE_USER_HOME}/wrapper/dists/gradle-${GRADLE_VERSION}" "${DIST_DIR}"
    rm -f "${ZIP_FILE}"
fi
exec "${DIST_DIR}/gradle-${GRADLE_VERSION}/bin/gradle" "$@"
